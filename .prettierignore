# Prose is maintained by hand. Prettier's markdown opinions (notably rewriting
# *emphasis* to _emphasis_) create churn in the session log on every commit
# without improving anything.
*.md


# Supabase CLI state written on a developer's machine (`supabase link` writes
# .temp/). Git-ignored by supabase/.gitignore, which Prettier doesn't read, so
# without these lines format:check fails only on machines that have linked.
supabase/.temp
supabase/.branches

# Session worktrees (each a full checkout with its own node_modules). Git hides
# them through .git/info/exclude, which Prettier doesn't read, so without this
# line format:check fails locally while a worktree exists.
.claude/worktrees

# Playwright output
playwright-report
test-results
