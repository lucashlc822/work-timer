{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starkeep",
  "version": "0.1.0",
  "identifier": "dev.lucashlc.starkeep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Starkeep",
        "width": 480,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0b0a1a",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
